		local send_content="${send_content}${str_linefeed}${str_tab}外网ip:${send_hostIP}"
		if [ ! -z "$pushbot_ipv6" ] && [ "$pushbot_ipv6" -ne "0" ]; then
			local send_wanIPv6=`getip wanipv6`;local send_hostIPv6=`getip hostipv6`
			local send_content="${send_content}${str_linefeed}${str_tab}ipv6 :${send_wanIPv6}"
			local send_content="${send_content}${str_linefeed}${str_tab}外网v6:${send_hostIPv6}"
		fi
		# 【修复】旁路由/无外网 IP 场景下 send_hostIP 可能为空，
		# 空 pattern 会让 grep -q -w 打印 Usage 并返回 2。加非空判断。
		[ ! -z "$send_hostIP" ] && ( ! echo "$send_wanIP"|grep -q -w "${send_hostIP}" ) && local send_content="${send_content}${str_linefeed}${str_tab}外网 ip 与接口 ip 不一致，你的 ip 不是公网 ip"
		local interfaceuptime=`getinterfaceuptime`
		[ ! -z "$interfaceuptime" ] && local wanstatustime=`getinterfaceuptime|awk -F. '{run_days=$1 / 86400;run_hour=($1 % 86400)/3600;run_minute=($1 % 3600)/60;run_second=$1 % 60;printf("在线时间：%d天%d时%d分%d秒",run_days,run_hour,run_minute,run_second)}'` && unset run_days run_hour run_minute run_second
		local send_content="${send_content}${str_linefeed}${str_tab}${wanstatustime}"
	fi

	if [ -z "$1" ] && [ ! -z "$client_list" ] && [ "$client_list" -eq "1" ]; then
		wait
		local IPLIST=`cat ${dir}ipAddress 2>/dev/null|awk '{print $1}'`
		[ -f ${dir}ipAddress ] && local logrow=$(grep -c "" ${dir}ipAddress) || local logrow="0"
		[ "$logrow" -eq "0" ] && local send_content="${send_content}${str_splitline}${str_title_start}${font_red} 当前无在线设备${font_end}${str_title_end}" || local send_content="${send_content}${str_splitline}${str_title_start}${font_blue} 现有在线设备 ${logrow} 台${font_end}${str_title_end}"
		# 设备数上限：企业微信 markdown 内容上限 4096 字节，设备过多会导致整条推送失败
		local __cl_max=`uci get pushbot.pushbot.client_list_max 2>/dev/null`
		case "$__cl_max" in ''|*[!0-9]*) __cl_max=20 ;; esac
		local __cl_i=0
		for ip in $IPLIST; do
			__cl_i=`expr $__cl_i + 1`
			if [ "$__cl_i" -gt "$__cl_max" ]; then
				local __cl_rest=`expr $logrow - $__cl_max`
				local send_content="${send_content}${str_linefeed}${str_tab}…… 另有 ${__cl_rest} 台设备未列出（超出上限 ${__cl_max} 台）"
				break
			fi
			local time_up=`cat ${dir}ipAddress|grep -w ${ip}|awk '{print $4}'|grep -v "^$"|sort -u|head -n1`
			local time1=`date +%s`
			local time1=$(time_for_humans `expr ${time1} - ${time_up}`)
			local ip_mac=`getmac ${ip}`
			local ip_name=`pretty_name ${ip} ${ip_mac} \`getname ${ip} ${ip_mac}\``
			local ip_total=`usage get ${ip_mac}`;[ ! -z "$ip_total" ] && local ip_total="总计流量：${ip_total}  "
			local ip_name=`cut_str $ip_name 18`
			local send_content="${send_content}${str_linefeed}${str_tab}${font_green2}【${ip_name}】${font_end2}  ${ip}${str_linefeed}${str_tab}${ip_total}在线 ${time1}"
			unset ip_total time_down time_up time1 ip_mac ip_name
		done
		unset __cl_i __cl_max __cl_rest
	fi

	[ ! -z "$device_name" ] && local send_title="【$device_name】${send_title}"
	[ -z "$send_content" ] && local send_content="${str_splitline}${str_title_start} 我遇到了一个难题${str_title_end}${str_linefeed}${str_tab}定时发送选项错误，你没有选择需要发送的项目，该怎么办呢${str_splitline}"
	# 修复：原实现用 $? 捕获的是 [ ] 判断结果而非 diy_send 返回值，导致成功也报失败
	local __send_rc=0
	if [ "$send_disturb" -eq "0" ]; then
		diy_send "${send_title}" "${send_content}" >/dev/null 2>&1
		__send_rc=$?
	fi
	if [ "$__send_rc" -eq 1 ]; then
		echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】定时推送失败，请检查网络或设置信息" >> ${logfile}
	else
		echo "`date "+%Y-%m-%d %H:%M:%S"` ${disturb_text}定时推送任务完成" >> ${logfile}
	fi
	unset __send_rc
	deltemp
}

# 初始化
read_config
deltemp
pushbot_cron

# 限制并发进程
[ -z "$thread_num" ] || [ "$thread_num" -eq "0" ] && thread_num=5
[ -e ${dir}fd1 ] || mkfifo ${dir}fd1
exec 5<>${dir}fd1
rm -f ${dir}fd1 >/dev/null 2>&1
for i in `seq 1 $thread_num`; do
	echo >&5
done
unset i

# 启动参数
if [ "$1" ] ;then
	[ "$1" == "send" ] && send
	[ "$1" == "soc" ] && echo `soc_temp` > ${dir}soc_tmp
	[ "$1" == "client" ] && get_client
	[ "$1" == "test" ] && send test
	exit 0
fi

# 载入在线设备
pushbot_init;[ $? -eq 1 ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】读取设置出错，请检查设置项 " >> ${logfile} && exit
echo "`date "+%Y-%m-%d %H:%M:%S"` 【初始化】载入在线设备" >> ${logfile}
> ${dir}send_enable.lock && pushbot_first && deltemp
echo "`date "+%Y-%m-%d %H:%M:%S"` 【初始化】初始化完成" >> ${logfile}

# 循环
# 脚本自更新守卫：ash 按字节偏移流式读取脚本，原地替换文件后
# 运行中的守护进程仍在执行旧代码（编辑内容落在已消费的偏移之前）。
# 每轮校验脚本 md5，一旦变化即退出，由 init 脚本拉起新进程。
__self_md5=`md5sum /usr/bin/pushbot/pushbot 2>/dev/null|awk '{print $1}'`
echo "$__self_md5" > ${dir}self_md5 2>/dev/null
while [ "$pushbot_enable" -eq "1" ]; do
	__now_md5=`md5sum /usr/bin/pushbot/pushbot 2>/dev/null|awk '{print $1}'`
	if [ ! -z "$__self_md5" ] && [ ! -z "$__now_md5" ] && [ "$__self_md5" != "$__now_md5" ]; then
		echo "`date "+%Y-%m-%d %H:%M:%S"` 【自更新】检测到脚本变更，重启守护进程以加载新代码" >> ${logfile}
		/etc/init.d/pushbot restart >/dev/null 2>&1 &
		exit 0
	fi
	deltemp
	usage update
	pushbot_disturb;disturb=$?

	# 外网IP变化检测
	[ -f ${dir}ipAddress ] && ipAddress_logrow=$(grep -c "" ${dir}ipAddress) || ipAddress_logrow="0";
	if [ $ipAddress_logrow -ne "0" ]; then
		online_list=`cat ${dir}ipAddress|awk '{print $2}'|grep -v "^$"|sort -u`
		for online_mac in $online_list; do
			[ ! -z "$online_mac" ] && mac_online_status="`echo "$mark_mac_list"|grep -i $online_mac|grep -v "^$"|sort -u|head -n1`${mac_online_status}"
		done
	fi

	if [ "$pushbot_ipv4" -ne "0" ] || [ "$pushbot_ipv6" -ne "0" ]; then
		rand_geturl
		ip_changes
	fi

	# 设备列表
	if [ ! -f "${dir}send_enable.lock" ]; then
		[ ! -z "$title" ] && echo "$title" > ${dir}title
		[ ! -z "$content" ] && echo "$content" > ${dir}content
		pushbot_first
		[ -f "${dir}title" ] && title=`cat ${dir}title` && rm -f ${dir}title >/dev/null 2>&1
		[ -f "${dir}content" ] && content=`cat ${dir}content` && rm -f ${dir}content >/dev/null 2>&1
	fi

	# 离线缓存区推送
	[ ! -f "${dir}send_enable.lock" ] && down_send

	# 当前设备列表
	[ ! -z "$content" ] && [ ! -f "${dir}send_enable.lock" ] && current_device

	# 无人值守任务
	[ ! -f "${dir}send_enable.lock" ] && unattended

	# CPU 检测
	[ ! -f "${dir}send_enable.lock" ] && cpu_load

	# 异常流量检测
	[ ! -f "${dir}send_enable.lock" ] && get_client_usage

	# 登录提醒通知
	[ ! -f "${dir}send_enable.lock" ] && login_send

	# 通知
	if [ ! -f "${dir}send_enable.lock" ] && [ ! -z "$title" ] && [ ! -z "$content" ]; then
		[ ! -z "$device_name" ] && title="【$device_name】$title"
		( echo "$lite_enable"|grep -q "content" ) && content="$title"
		[ "$disturb" -eq "0" ] && diy_send "${title}" "${content}" >/dev/null 2>&1
		[ $? -eq 1 ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】推送失败，请检查网络或设置信息 " >> ${logfile}
	fi
	
	while [ -f "${dir}send_enable.lock" ]; do
		sleep $sleeptime
	done
	sleep $sleeptime
done
