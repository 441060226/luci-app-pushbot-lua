#!/bin/sh

# 读取设置文件
function get_config(){
	while [[ "$*" != "" ]]; do
		eval ${1}='`uci get pushbot.pushbot.$1`' 2>/dev/null
		shift
	done
}

# 初始化设置信息
function read_config(){
	get_config "pushbot_enable" "lite_enable" "device_name" "sleeptime" "oui_dir" "oui_data" "reset_regularly" "debuglevel" "device_aliases" \
	"pushbot_ipv4" "ipv4_interface" "pushbot_ipv6" "ipv6_interface" "pushbot_up" "pushbot_down" "cpuload_enable" "cpuload" "temperature_enable" "temperature" \
	"regular_time" "regular_time_2" "regular_time_3" "interval_time" \
	"client_usage" "client_usage_max" "client_usage_disturb" "client_usage_whitelist" \
	"web_logged" "ssh_logged" "web_login_failed" "ssh_login_failed" "login_max_num" "web_login_black" "ip_white_list" "ip_black_timeout" \
	"pushbot_sheep" "starttime" "endtime" "pushbot_whitelist" "pushbot_blacklist" "pushbot_interface" "MAC_online_list" "MAC_offline_list" \
	"up_timeout" "down_timeout" "timeout_retry_count" "thread_num" "soc_code" "pve_host" "pve_port"\
	"err_enable" "err_sheep_enable" "err_device_aliases" "network_err_event" "system_time_event" "autoreboot_time" "network_restart_time" "public_ip_event" "public_ip_retry_count" \
	"jsonpath" "pushbot_channels" "dd_webhook" "we_webhook" "we_corpid" "we_corpsecret" "we_agentid" "we_touser" "pp_token" "pp_channel" "pp_webhook" "pp_topic_enable" "pp_topic" "fs_webhook" "pushdeer_key" "pushdeer_srv_enable" "pushdeer_srv" "bark_srv_enable" "bark_srv" "bark_token" "bark_sound" "bark_icon" "bark_icon_enable" "bark_level"
	
	# 检测包管理器版本（OpenWrt 24.10 及之前用 opkg，25.12 起用 apk）
	if command -v opkg >/dev/null 2>&1; then
		pkg_mgr="opkg"
	elif command -v apk >/dev/null 2>&1; then
		pkg_mgr="apk"
	else
		pkg_mgr="none"
	fi
	for str_version in "wrtbwmon" "iputils-arping" "curl" "iw"; do
		case "$pkg_mgr" in
			opkg) eval `echo ${str_version:0:2}"_version"`=`opkg list-installed 2>/dev/null|grep -w ^${str_version}|awk '{print $3}'` 2>/dev/null ;;
			apk)  eval `echo ${str_version:0:2}"_version"`=`apk list --installed 2>/dev/null|grep -w ^${str_version}|head -n1|sed -n 's/^[^ ]* \([^ ]*\).*/\1/p'` 2>/dev/null ;;
			*)    eval `echo ${str_version:0:2}"_version"`="" ;;
		esac
	done
	dir="/tmp/pushbot/" && mkdir -p ${dir}
	tempjsonpath="/tmp/pushbot/temp.json"
	ip_blacklist_path="/usr/bin/pushbot/api/ip_blacklist"
	[ ! -z "$oui_dir" ] && [ "$oui_dir" -eq "1" ] && oui_base="${dir}oui_base.txt" || oui_base="/usr/bin/pushbot/oui_base.txt"
	debuglevel=`echo "$debuglevel"` && [ -z "$debuglevel" ] && logfile="/dev/null" || logfile="${dir}pushbot.log"
	pushbot_blacklist=`echo "$pushbot_blacklist"|sed 's/ /\n/g'` 2>/dev/null
	pushbot_whitelist=`echo "$pushbot_whitelist"|sed 's/ /\n/g'` 2>/dev/null
	device_aliases=`echo "$device_aliases"|sed 's/ /\n/g'|sed 's/-/ /'` 2>/dev/null
	err_device_aliases=`echo "$err_device_aliases"|sed 's/ /\n/g'` 2>/dev/null
	# 设备备注（nlbwmon notes.json）—— 最高优先级名称来源，有备注则替换原设备名
	notes_file="/etc/nlbwmon/notes.json"
	notes_alias="${dir}notes_alias.txt"
	: > "$notes_alias" 2>/dev/null
	if [ -f "$notes_file" ]; then
		awk '
			{
				s = $0
				while (match(s, /"[0-9A-Fa-f:]+"[ \t]*:[ \t]*"[^"]*"/)) {
					item = substr(s, RSTART, RLENGTH)
					split(item, a, "\"")
					mac = toupper(a[2]); txt = a[4]
					printf "%s %s|", mac, txt
					s = substr(s, RSTART + RLENGTH)
				}
			}
		' "$notes_file" | tr '|' '\n' | grep -v '^$' > "$notes_alias" 2>/dev/null
	fi
	client_usage_whitelist=`echo "$client_usage_whitelist"|sed 's/ /\n/g'` 2>/dev/null
	ip_white_list=`echo "$ip_white_list"|sed 's/ /\n/g'` 2>/dev/null
	mark_mac_list="${MAC_online_list} ${MAC_offline_list}"
	mark_mac_list=`echo "$mark_mac_list"|sed 's/ /\n/g'|sed 's/-/ /'` 2>/dev/null
	ipv4_urllist=`cat /usr/bin/pushbot/api/ipv4.list` 2>/dev/null
	ipv6_urllist=`cat /usr/bin/pushbot/api/ipv6.list` 2>/dev/null
	[ -z "$pushbot_ipv4" ] && pushbot_ipv4=0
	[ -z "$pushbot_ipv6" ] && pushbot_ipv6=0
	[ "$iw_version" ] && wlan_interface=`iw dev|grep Interface|awk '{print $2}'` >/dev/null 2>&1
	[ -z "$up_timeout" ] || [ "$up_timeout" -eq "0" ] && up_timeout="2"
	[ -z "$down_timeout" ] || [ "$down_timeout" -eq "0" ] && down_timeout="20";down_timeout=`expr ${down_timeout} / 2 + 1`
	[ -z "$timeout_retry_count" ] && timeout_retry_count="2";[ "$timeout_retry_count" -eq "0" ] && timeout_retry_count="1"
	[ ! -z "$bark_token" ] && [ -z "$bark_srv" ] && bark_srv="https://api.day.app"
	[ ! -z "$pushdeer_key" ] && [ -z "$pushdeer_srv" ] && pushdeer_srv="https://api2.pushdeer.com"
	
# 多平台推送渠道解析
# pushbot_channels 为空格分隔的 json 路径列表，如：
#   /usr/bin/pushbot/api/dingding.json /usr/bin/pushbot/api/ent_wechat.json
# 兼容处理：
#   1) 新配置 pushbot_channels（多选）优先
#   2) 回退旧配置 jsonpath（单选）
# 最终写入 channel_list（空格分隔），并由 channel_primary 保存主渠道（第一个）
function parse_channels(){
	channel_list=""
	if [ ! -z "$pushbot_channels" ]; then
		for __ch in $pushbot_channels; do
			[ -f "$__ch" ] && channel_list="${channel_list} ${__ch}"
		done
		channel_list=`echo "$channel_list"|sed 's/^ *//'`
	fi
	# 无有效多渠道配置时回退到单选 jsonpath
	if [ -z "$channel_list" ] && [ ! -z "$jsonpath" ] && [ -f "$jsonpath" ]; then
		channel_list="$jsonpath"
	fi
	channel_primary=`echo "$channel_list"|awk '{print $1}'`
	# 主渠道不存在时兜底到钉钉，保证后续 jq 不报错
	[ -z "$channel_primary" ] && channel_primary="/usr/bin/pushbot/api/dingding.json"
	channel_primary=`echo "$channel_primary"|sed 's/^ *//'`
	unset __ch
}

# 字符串读取
	parse_channels
	jsonpath="$channel_primary"
	str_title_start=`/usr/bin/jq -r '.str_title_start' ${jsonpath}`
	str_title_end=`/usr/bin/jq -r '.str_title_end' ${jsonpath}`
	str_linefeed=`/usr/bin/jq -r '.str_linefeed' ${jsonpath}`
	str_splitline=`/usr/bin/jq -r '.str_splitline' ${jsonpath}`
	str_space=`/usr/bin/jq -r '.str_space' ${jsonpath}`
	str_tab=`/usr/bin/jq -r '.str_tab' ${jsonpath}`
	font_red=`/usr/bin/jq -r '.font_red' ${jsonpath}`
	font_green=`/usr/bin/jq -r '.font_green' ${jsonpath}`
	font_green2=`/usr/bin/jq -r '.font_green2' ${jsonpath}`
	font_blue=`/usr/bin/jq -r '.font_blue' ${jsonpath}`
	font_purple=`/usr/bin/jq -r '.font_purple' ${jsonpath}`
	font_end=`/usr/bin/jq -r '.font_end' ${jsonpath}`
	font_end2=`/usr/bin/jq -r '.font_end2' ${jsonpath}`
	percentsym=`/usr/bin/jq -r '.percentsym' ${jsonpath}`
	boldstar=`/usr/bin/jq -r '.boldstar' ${jsonpath}`
	table_tab=`/usr/bin/jq -r '.tabletab' ${jsonpath}`
	( echo "$lite_enable"|grep -q "content" ) && str_title_start="" && str_title_end="" && str_splitline="" && str_linefeed="" && str_tab=""
}
	
	

# 初始化
function pushbot_init(){
	enable_detection
	if [ -f "/usr/bin/pushbot/errlog" ]; then
		cat /usr/bin/pushbot/errlog > ${logfile}
		echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】载入上次重启前日志" >> ${logfile}
		echo "--------------------------------------------------------" >> ${logfile}
	fi
	down_oui &
	deltemp
	get_syslog
	add_ip_black
	
	rm -f ${dir}fd1 ${dir}sheep_usage ${dir}old_sheep_usage ${dir}client_usage_aliases ${dir}old_client_usage_aliases /usr/bin/pushbot/errlog >/dev/null 2>&1
	# 流量统计依赖：wrtbwmon（旧，已从官方源移除）或 nlbwmon（新，官方推荐）
	# 两者任一可用即可；都没有才提示不可用
	if [ ! -f "/usr/sbin/wrtbwmon" ] && [ ! -f "/usr/sbin/nlbwmon" ]; then
		echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】未安装 wrtbwmon / nlbwmon，流量统计不可用" >> ${logfile}
	fi
	[ -z "$ip_version" ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】无法获取依赖项 iputils-arping 版本号，请确认插件是否正常运行" >> ${logfile}
	[ -z "$cu_version" ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】无法获取依赖项 curl 版本号，请确认插件是否正常运行" >> ${logfile}
	# 多平台：只要任意一个渠道配置了凭证即可启动
	if [ -z "${dd_webhook}${pp_token}${we_webhook}${we_corpid}${fs_webhook}${bark_token}${pushdeer_key}" ]; then
		echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】请填写正确的Token/Webhook " >> ${logfile}
		return 1
	fi
	# 注：各渠道「未配置 → 跳过」的提示由发送阶段的 diy_send_one() 统一输出，
	#     那里能指出具体缺失的字段，此处不再重复打印，避免同一件事出现两条日志。
	local interfacelist=`getinterfacelist` && [ -z "$interfacelist" ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】无法正确获取接口信息，请确认插件是否正常运行" >> ${logfile}
	return 0
}

# 获取企业微信应用 access_token（带文件缓存，有效期 7200 秒，提前 300 秒刷新）
function get_we_token(){
	if [ -z "$we_corpid" ] || [ -z "$we_corpsecret" ]; then
		return 1
	fi
	local token_cache="${dir}we_token.cache"
	# 命中缓存直接返回
	if [ -f "$token_cache" ]; then
		local cache_time=`sed -n '1p' "$token_cache" 2>/dev/null`
		local cache_token=`sed -n '2p' "$token_cache" 2>/dev/null`
		local now=`date +%s`
		if [ ! -z "$cache_time" ] && [ ! -z "$cache_token" ] && [ $((now - cache_time)) -lt 6900 ]; then
			echo "$cache_token"
			return 0
		fi
	fi
	# 重新获取
	local resp=`curl -s -k -m 10 "https://qyapi.weixin.qq.com/cgi-bin/gettoken?corpid=${we_corpid}&corpsecret=${we_corpsecret}"`
	local new_token=`echo "$resp"|/usr/bin/jq -r '.access_token' 2>/dev/null`
	if [ -z "$new_token" ] || [ "$new_token" = "null" ]; then
		echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】企业微信 gettoken 返回：${resp}" >> ${logfile}
		return 1
	fi
	echo "`date +%s`" > "$token_cache"
	echo "$new_token" >> "$token_cache"
	echo "$new_token"
	return 0
}

# 单渠道推送（内部函数）
# 参数：$1=title $2=content $3=json模板路径
# 渠道显示名映射：内部标识符（文件名）→ 用户可读的中文名
# 用于日志输出，避免出现 ent_wechat / ent_wechat_app 这类英文标识
function cname_cn(){
	case "$1" in
		dingding)        echo "钉钉" ;;
		ent_wechat)      echo "企业微信机器人" ;;
		ent_wechat_app)  echo "企业微信应用" ;;
		feishu)          echo "飞书" ;;
		bark)            echo "Bark" ;;
		pushplus)        echo "PushPlus" ;;
		pushdeer)        echo "PushDeer" ;;
		diy)             echo "自定义推送" ;;
		*)               echo "$1" ;;
	esac
}

function diy_send_one(){
	local __json="$3"
	[ ! -f "$__json" ] && return 1

	# 【修复】渠道未配置守卫：放在最前面，未配置的渠道直接标记 skipped（返回 2），
	# 避免后续拼出畸形 URL 让 curl 静默"成功"（假成功），也避免无谓的网络请求。
	local __cname=`basename "$__json" .json`
	local __rawurl=`/usr/bin/jq -r .url ${__json}`
	local __evalurl=`eval echo ${__rawurl}`
	case "$__cname" in
		dingding)
			if [ -z "$dd_webhook" ]; then
				echo "`date "+%Y-%m-%d %H:%M:%S"` 【跳过】[$(cname_cn $__cname)] 未填写 Webhook，已跳过" >> ${logfile}
				return 2
			fi
			;;
		ent_wechat)
			if [ -z "$we_webhook" ]; then
				echo "`date "+%Y-%m-%d %H:%M:%S"` 【跳过】[$(cname_cn $__cname)] 未填写 Webhook，已跳过" >> ${logfile}
				return 2
			fi
			;;
		ent_wechat_app)
			if [ -z "$we_corpid" ] || [ -z "$we_corpsecret" ] || [ -z "$we_agentid" ]; then
				echo "`date "+%Y-%m-%d %H:%M:%S"` 【跳过】[$(cname_cn $__cname)] 未填写 corpid/corpsecret/agentid，已跳过" >> ${logfile}
				return 2
			fi
			;;
		feishu)
			if [ -z "$fs_webhook" ]; then
				echo "`date "+%Y-%m-%d %H:%M:%S"` 【跳过】[$(cname_cn $__cname)] 未填写 Webhook，已跳过" >> ${logfile}
				return 2
			fi
			;;
		pushplus)
			if [ -z "$pp_token" ]; then
				echo "`date "+%Y-%m-%d %H:%M:%S"` 【跳过】[$(cname_cn $__cname)] 未填写 Token，已跳过" >> ${logfile}
				return 2
			fi
			;;
		bark)
			if [ -z "$bark_srv" ] || [ -z "$bark_token" ]; then
				echo "`date "+%Y-%m-%d %H:%M:%S"` 【跳过】[$(cname_cn $__cname)] 未填写 Token/服务器，已跳过" >> ${logfile}
				return 2
			fi
			;;
		pushdeer)
			if [ -z "$pushdeer_srv" ] || [ -z "$pushdeer_key" ]; then
				echo "`date "+%Y-%m-%d %H:%M:%S"` 【跳过】[$(cname_cn $__cname)] 未填写 Key/服务器，已跳过" >> ${logfile}
				return 2
			fi
			;;
		diy)
			# diy.json 是用户自由编辑的模板，凭据直接写在 url/type 里。
			# 判定"未配置"：地址仍残留 Telegram 模板且 token 为空（.../bot/sendMessage）。
			case "$__evalurl" in
				*"/bot/sendMessage"*) echo "`date "+%Y-%m-%d %H:%M:%S"` 【跳过】[$(cname_cn $__cname)] 模板未配置有效地址（${__evalurl}），已跳过" >> ${logfile}; return 2 ;;
			esac
			;;
	esac
	# URL 必须以 http 开头，否则 curl 会误当本地路径返回 0（假成功）
	case "$__evalurl" in
		http://*|https://*) : ;;
		*) echo "`date "+%Y-%m-%d %H:%M:%S"` 【跳过】[$(cname_cn $__cname)] API 地址无效/未配置（${__evalurl}），已跳过" >> ${logfile}; return 2 ;;
	esac

	# 企业微信应用消息：token 需实时获取（有效期 7200 秒）
	if ( echo "$__json"|grep -q "ent_wechat_app.json" ); then
		local __we_token=`get_we_token`
		if [ -z "$__we_token" ]; then
			echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】企业微信应用 access_token 获取失败，请检查 corpid/corpsecret" >> ${logfile}
			return 1
		fi
		# 将 token 暂存到配置，供后续 eval 展开使用
		export we_token="$__we_token"
	fi

	local diyurl=`/usr/bin/jq -r .url ${__json}` && local diyurl=`eval echo ${diyurl}`
	local type=`/usr/bin/jq -r '.type' ${__json}` && local type=`eval echo ${type}`
	local data=`/usr/bin/jq -r '.data' ${__json}` && local data=`eval echo ${data}`
	local content_type=`/usr/bin/jq -r '.content_type' ${__json}`
	# 每个渠道使用独立临时文件，避免多渠道互相覆盖
	local __tempjson="${tempjsonpath}.${__cname}"
	data=`echo "$data"|sed "s#${tempjsonpath}#${__tempjson}#g"`
	/usr/bin/jq ".type + $type" ${__json} > ${__tempjson}
	/usr/bin/jq -r '.[]' ${__tempjson}|grep -w "null" && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】[$(cname_cn $__cname)] 参数值错误，请检查设置项  `/usr/bin/jq -r '.' ${__tempjson}|grep "null"`" >> ${logfile} && rm -f ${__tempjson} && return 1
	[ -f ${__tempjson} ] && local logrow=$(grep -c "" ${__tempjson}) || local logrow="0"
	[ $logrow -eq "0" ] && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】[$(cname_cn $__cname)] json 文件生成失败，请检查文件格式" >> ${logfile} && return 1
	/usr/bin/jq -r '.[]' ${__tempjson}|grep "null" && echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】[$(cname_cn $__cname)] 参数变量生成失败，请检查设置项 `/usr/bin/jq -r '.' ${__tempjson}|grep "null"`" >> ${logfile}

	# 带超时保护（连接 5s / 总 15s），单渠道失败不影响其它渠道
	# 同时抓取 HTTP 状态码，非 2xx 视为失败
	local __resp=`curl -s -k -m 15 --connect-timeout 5 -w "\n__HTTP__%{http_code}" -X POST -H "$content_type" -d "${data}" "${diyurl}" 2>/dev/null`
	local __curl_rc=$?
	local __http=`echo "$__resp"|sed -n 's/.*__HTTP__//p'|tail -1`
	__resp=`echo "$__resp"|sed 's/__HTTP__[0-9]*$//'`
	rm -f ${__tempjson}
	if [ $__curl_rc -ne 0 ]; then
		echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】[$(cname_cn $__cname)] 请求失败 curl=$__curl_rc" >> ${logfile}
		return 1
	fi
	# HTTP 状态码感知：非 2xx 视为失败
	if [ ! -z "$__http" ] && [ "$__http" -ge 400 ] 2>/dev/null; then
		echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】[$(cname_cn $__cname)] HTTP ${__http} 请求失败：${__resp}" >> ${logfile}
		return 1
	fi
	# 返回值感知：errcode/code/StatusCode 非 0 视为失败
	local __errcode=`echo "$__resp"|/usr/bin/jq -r '.errcode // .code // .StatusCode // empty' 2>/dev/null`
	if [ ! -z "$__errcode" ] && [ "$__errcode" != "0" ]; then
		echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】[$(cname_cn $__cname)] 平台返回错误：${__resp}" >> ${logfile}
		return 1
	fi
	# 布尔型返回感知：ok/result/success 为 false 视为失败（如 Telegram {"ok":false}）
	local __okflag=`echo "$__resp"|/usr/bin/jq -r 'if (.ok // empty) == false then "false" elif (.success // empty) == false then "false" else empty end' 2>/dev/null`
	if [ "$__okflag" = "false" ]; then
		echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】[$(cname_cn $__cname)] 平台返回失败：${__resp}" >> ${logfile}
		return 1
	fi
	return 0
}

# 推送（多平台）
# 参数：$1=title $2=content $3=（兼容旧调用）json路径；为空时使用 channel_list 全部渠道
# 返回：全部渠道中只要有任意一个失败则返回 1，全部成功返回 0
function diy_send(){
	( ! echo "$lite_enable"|grep -q "content" ) && ( ! echo "$lite_enable"|grep -q "nowtime" ) && local nowtime=`date "+%Y-%m-%d %H:%M:%S"`
	# 兼容旧调用：显式传入第 3 个参数时，只推送该渠道
	local __send_list="$channel_list"
	[ ! -z "$3" ] && __send_list="$3"
	[ -z "$__send_list" ] && __send_list="$jsonpath"

	# 逐渠道发送（curl 已带超时，单渠道慢不会无限阻塞）
	local __rc=0
	local __all=0
	local __ok=0
	local __skip=0
	for __ch in $__send_list; do
		local __cname=`basename "$__ch" .json`
		__all=$((__all + 1))
		diy_send_one "$1" "$2" "$__ch" >/dev/null 2>&1
		local __one_rc=$?
		if [ $__one_rc -eq 0 ]; then
			__ok=$((__ok + 1))
			echo "`date "+%Y-%m-%d %H:%M:%S"` [$(cname_cn $__cname)] 推送成功" >> ${logfile}
		elif [ $__one_rc -eq 2 ]; then
			# 未配置渠道：已跳过，不计入成功也不计入失败
			__skip=$((__skip + 1))
		else
			echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】[$(cname_cn $__cname)] 推送失败" >> ${logfile}
			__rc=1
		fi
	done
	unset __ch
	echo "`date "+%Y-%m-%d %H:%M:%S"` 【多平台推送】共 $__all 个渠道，成功 $__ok 个，跳过 $__skip 个，失败 $((__all - __ok - __skip)) 个" >> ${logfile}
	unset __cname
	return $__rc
}

# 下载设备MAC厂商信息
function down_oui(){
	# ★ 修复：原实现用 wget --no-check-certificate -t/-T，BusyBox wget 不识别这些参数，
	#   会直接打印 Usage 后退出 → 文件从未下载成功，且因 [ -f oui.txt ] 判断失败而
	#   完全不写日志，问题被静默掩盖。改用 curl（实测可正常下载 IEEE OUI 数据）。
	[ -f ${oui_base} ] && local logrow=$(grep -c "" ${oui_base}) || local logrow="0"
	# 库文件行数太少视为损坏，删除后重新下载
	[ $logrow -lt "10" ] && rm -f ${oui_base} >/dev/null 2>&1
	if [ ! -z "$oui_data" ] && [ "$oui_data" -ne "3" ] && [ ! -f ${oui_base} ]; then
		echo "`date "+%Y-%m-%d %H:%M:%S"` 【初始化】设备MAC厂商信息不存在，重新下载" >> ${logfile}
		# 下载原始 OUI 数据（IEEE 官方，约 6~7MB）
		curl -k -s -m 120 -o ${dir}oui.txt https://standards-oui.ieee.org/oui/oui.txt >/dev/null 2>&1
		local __oui_raw=0
		[ -f ${dir}oui.txt ] && __oui_raw=$(grep -c "base 16" ${dir}oui.txt 2>/dev/null)
		[ -z "$__oui_raw" ] && __oui_raw=0
		if [ "$__oui_raw" -lt "1000" ]; then
			# ★ 下载失败/内容异常：明确记录，不再静默
			echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】设备MAC厂商信息下载失败（原始数据仅 ${__oui_raw} 条，请检查网络或上游是否可达）" >> ${logfile}
			rm -f ${dir}oui.txt ${oui_base} >/dev/null 2>&1
			return 1
		fi
		local __oui_rc=1
		if [ "$oui_data" -eq "1" ]; then
			cat ${dir}oui.txt|grep "base 16"|grep -i "apple\|aruba\|asus\|autelan\|belkin\|bhu\|buffalo\|cctf\|cisco\|comba\|datang\|dell\|dlink\|dowell\|ericsson\|fast\|feixun\|\
fiberhome\|fujitsu\|grentech\|h3c\|hisense\|hiwifi\|honghai\|honghao\|hp\|htc\|huawei\|intel\|jinli\|jse\|lenovo\|lg\|liteon\|malata\|meizu\|mercury\|meru\|moto\|netcore\|\
netgear\|nokia\|omron\|oneplus\|oppo\|philips\|router_unkown\|samsung\|shanzhai\|sony\|start_net\|sunyuanda\|tcl\|tenda\|texas\|tianyu\|tp-link\|ubq\|undefine\|VMware\|\
utstarcom\|volans\|xerox\|xiaomi\|zdc\|zhongxing\|smartisan" > ${oui_base} 2>/dev/null && __oui_rc=0
		elif [ "$oui_data" -eq "2" ]; then
			cat ${dir}oui.txt|grep "base 16" > ${oui_base} 2>/dev/null && __oui_rc=0
		fi
		rm -f ${dir}oui.txt >/dev/null 2>&1
		# 复核产物确实可用（有内容且行数达标），否则视为失败
		local __oui_lines=0
		[ -f ${oui_base} ] && __oui_lines=$(grep -c "" ${oui_base} 2>/dev/null)
		[ -z "$__oui_lines" ] && __oui_lines=0
		if [ "$__oui_rc" -eq "0" ] && [ "$__oui_lines" -ge "100" ]; then
			echo "`date "+%Y-%m-%d %H:%M:%S"` 【初始化】设备MAC厂商信息下载成功（${__oui_lines} 条记录）" >> ${logfile}
		else
			echo "`date "+%Y-%m-%d %H:%M:%S"` 【！！！】设备MAC厂商信息生成失败（产物 ${__oui_lines} 条，需 ≥100 条）" >> ${logfile}
			rm -f ${oui_base} >/dev/null 2>&1
			return 1
		fi
	fi
	return 0
}

